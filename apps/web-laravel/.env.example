APP_NAME=StageHome
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# The FastAPI backend (apps/api-py). Same variable name convention as the
# rest of this project uses for the API base URL.
STAGEHOME_API_BASE_URL=https://api-v8-production.up.railway.app/api/v1

LOG_CHANNEL=stack
LOG_LEVEL=info

# Laravel session/cache use its own Redis connection, independent of the
# FastAPI backend's own REDIS_URL — no shared state between the two
# processes, deliberately: the API remains the single source of truth.
SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
