{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web-laravel/Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec php artisan serve --host=0.0.0.0 --port=$PORT\"",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
