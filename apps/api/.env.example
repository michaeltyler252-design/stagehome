# ============================================================================
# API environment variables — Milestone 1 inventory
# Copy to .env and fill in real values. Never commit the real .env file.
# Variables marked (M2+) are declared now for architecture completeness but
# are not required until their owning milestone (auth, payments, agreements).
# ============================================================================

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_APP_ORIGIN=http://localhost:3000

# --- Database (Part D: PostgreSQL + PostGIS via Prisma) ---
DATABASE_URL=postgresql://shm_dev:changeme_dev_only@localhost:5432/shm_dev?schema=public

# --- Cache / queues / locks (Part D: Redis for cache, rate limits, queues, reservation locks) ---
REDIS_URL=redis://:changeme_dev_only@localhost:6379

# --- Auth (M3 — Authentication and permissions) ---
JWT_ACCESS_SECRET=replace_with_generated_secret
JWT_REFRESH_SECRET=replace_with_generated_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=Information Required
GOOGLE_OAUTH_CLIENT_SECRET=Information Required
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
OTP_PROVIDER_API_KEY=Information Required

# --- Media storage (M4 — Property-management system) ---
MEDIA_STORAGE_PROVIDER=s3 # s3 | r2
MEDIA_STORAGE_BUCKET=Information Required
MEDIA_STORAGE_REGION=Information Required
MEDIA_STORAGE_ACCESS_KEY_ID=Information Required
MEDIA_STORAGE_SECRET_ACCESS_KEY=Information Required
MEDIA_CDN_BASE_URL=Information Required

# --- Maps (M4/M6 — Property pages, Search and filtering) ---
MAPS_PROVIDER=google # google | mapbox
MAPS_API_KEY=Information Required

# --- Payments (M8 — Payment system) ---
DARAJA_CONSUMER_KEY=Information Required
DARAJA_CONSUMER_SECRET=Information Required
DARAJA_PASSKEY=Information Required
DARAJA_SHORTCODE=Information Required
DARAJA_ENV=sandbox # sandbox | production
CARD_GATEWAY_PUBLIC_KEY=Information Required
CARD_GATEWAY_SECRET_KEY=Information Required
AIRTEL_MONEY_CLIENT_ID=Information Required
AIRTEL_MONEY_CLIENT_SECRET=Information Required

# --- Agreements / e-signature (M9) ---
ESIGNATURE_PROVIDER=Information Required
ESIGNATURE_API_KEY=Information Required

# --- Notifications (M10) ---
EMAIL_PROVIDER_API_KEY=Information Required
SMS_PROVIDER_API_KEY=Information Required
WHATSAPP_BUSINESS_TOKEN=Information Required
WHATSAPP_BUSINESS_PHONE_ID=Information Required

# --- Observability / operations (Part M) ---
SENTRY_DSN=Information Required
LOG_LEVEL=info
