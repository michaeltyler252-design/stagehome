# ============================================================================
# Web app environment variables — Milestone 1 inventory
# ============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (client-side autocomplete/rendering, M6) ---
