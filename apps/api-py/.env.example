# --- Core ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/stagehome

# --- Redis (Celery broker/backend + app-level caching, e.g. OTP codes, booking-hold locks) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# --- CORS ---
# The deployed Laravel frontend's exact origin. Required in production —
# the API refuses to boot without this set when NODE_ENV=production.
WEB_APP_ORIGIN=http://localhost:8000

# --- Google OAuth (optional — /auth/google refuses cleanly with 503 if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- M-Pesa Daraja (optional — /payments/initiate refuses cleanly with 503 if unset) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_ENV=sandbox

# --- Notification providers (optional — each channel logs-only in dev, refuses with 503 in production if unset) ---
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_BUSINESS_TOKEN=

# --- Error tracking (optional) ---
SENTRY_DSN=
