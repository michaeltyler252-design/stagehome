# pnpm, by default, uses a strict, symlinked node_modules structure
# (packages are only resolvable if explicitly declared as a dependency).
# Serverless-function bundlers that do static `require()` analysis — most
# notably Netlify's zip-it-and-ship-it — cannot always trace through that
# structure, which is exactly what causes:
#   Runtime.ImportModuleError: Cannot find module 'styled-jsx/style'
# `styled-jsx` is a transitive dependency of `next` itself (Next.js uses it
# internally for its built-in CSS-in-JS runtime, even if the app never
# imports it directly), so it's especially prone to being "invisible" to a
# bundler unless node_modules is flattened.
#
# shamefully-hoist=true flattens node_modules the way npm/yarn classic do,
# which is what these bundlers expect. This does not disable pnpm's
# workspace linking (packages/*, apps/* still resolve correctly) — it only
# affects how third-party dependencies are laid out on disk.
shamefully-hoist=true
