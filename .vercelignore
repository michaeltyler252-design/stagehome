# This Vercel project deploys apps/web only (see vercel.json). Excluding
# the rest of the monorepo keeps uploads smaller and removes any chance of
# Vercel's build accidentally discovering and trying to build apps/api
# (whose "nest build" script requires @nestjs/cli, which this frontend-only
# deploy never installs — see CHANGELOG.md for the incident this prevents).
apps/api
apps/worker
packages/database
infrastructure
docker-compose*.yml
Dockerfile
*.Dockerfile
